{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "playground",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5180,
      "autoPort": true
    },
    {
      "name": "storybook",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "storybook",
        "-w",
        "@unframed/storybook"
      ],
      "port": 6006
    },
    {
      "name": "website",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@unframed/website"
      ],
      "port": 5190,
      "autoPort": true
    },
    {
      "name": "storybook-static",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "6007",
        "--directory",
        "apps/storybook/dist"
      ],
      "port": 6007
    },
    {
      "name": "website-build",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "exec",
        "-w",
        "@unframed/website",
        "--",
        "vite",
        "preview",
        "--port",
        "5191",
        "--strictPort"
      ],
      "port": 5191
    }
  ]
}

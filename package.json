{
  "name": "unframed-ui",
  "private": true,
  "description": "Framework-agnostic web components. Use them anywhere, own them if you want.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/tokens",
    "packages/core",
    "packages/react",
    "packages/vue",
    "packages/angular",
    "packages/cli",
    "apps/storybook",
    "apps/website"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev -w @unframed/core",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "changeset": "changeset",
    "version-packages": "changeset version && npm run build -w @unframed/tokens && npm run analyze -w @unframed/core && npm run skill -w @unframed/cli",
    "release": "npm run build && changeset publish",
    "storybook": "npm run storybook -w @unframed/storybook",
    "website": "npm run dev -w @unframed/website"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@types/node": "^26.6.4",
    "@vitest/browser-playwright": "^5.0.3",
    "axe-core": "^4.13.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}

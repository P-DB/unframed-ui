{
  "name": "@unframed/react",
  "version": "0.8.0",
  "description": "Typed React wrappers for Unframed web components.",
  "license": "MIT",
  "author": "Patrizio Di Bartolomeo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/P-DB/unframed-ui.git",
    "directory": "packages/react"
  },
  "homepage": "https://p-db.github.io/unframed-ui/",
  "bugs": "https://github.com/P-DB/unframed-ui/issues",
  "keywords": [
    "react",
    "web-components",
    "lit",
    "ui"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "npm run generate && rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "npm run generate && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@lit/react": "^1.0.8",
    "@unframed/core": "0.8.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@unframed/core",
  "version": "0.11.0",
  "description": "Framework-agnostic web components built with Lit.",
  "license": "MIT",
  "author": "Patrizio Di Bartolomeo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/P-DB/unframed-ui.git",
    "directory": "packages/core"
  },
  "homepage": "https://p-db.github.io/unframed-ui/",
  "bugs": "https://github.com/P-DB/unframed-ui/issues",
  "keywords": [
    "web-components",
    "custom-elements",
    "lit",
    "ui",
    "design-system",
    "accessibility"
  ],
  "type": "module",
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./custom-elements.json": "./custom-elements.json",
    "./locales/*": {
      "types": "./dist/locales/*.d.ts",
      "default": "./dist/locales/*.js"
    },
    "./*": {
      "types": "./dist/components/*/*.d.ts",
      "default": "./dist/components/*/*.js"
    }
  },
  "customElements": "custom-elements.json",
  "sideEffects": [
    "./dist/components/**/*.js",
    "./dist/index.js",
    "./src/components/**/*.ts",
    "./src/index.ts"
  ],
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && npm run analyze && node scripts/check-docs.mjs && node scripts/check-ssr.mjs",
    "analyze": "custom-elements-manifest analyze",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "peerDependencies": {
    "@unframed/tokens": "*"
  },
  "publishConfig": {
    "access": "public"
  }
}

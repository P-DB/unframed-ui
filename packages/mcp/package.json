{
  "name": "@unframed/mcp",
  "version": "1.0.0-rc.6",
  "description": "MCP server for Unframed: lets AI coding tools look up components and check the code they write.",
  "license": "MIT",
  "author": "Patrizio Di Bartolomeo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/P-DB/unframed-ui.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://p-db.github.io/unframed-ui/docs/ai-assistants",
  "bugs": "https://github.com/P-DB/unframed-ui/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "web-components",
    "ui",
    "design-system",
    "accessibility"
  ],
  "type": "module",
  "bin": {
    "unframed-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "data.json"
  ],
  "scripts": {
    "data": "node scripts/build-data.mjs",
    "build": "npm run data && rm -rf dist && tsc -p tsconfig.json",
    "test": "npm run data && vitest run",
    "typecheck": "npm run data && tsc -p tsconfig.json --noEmit",
    "eval": "npm run build && node eval/run.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}

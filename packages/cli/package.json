{
  "name": "@unframed/cli",
  "version": "0.3.0",
  "description": "Copy Unframed web components into your project, and own the code.",
  "license": "MIT",
  "author": "Patrizio Di Bartolomeo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/P-DB/unframed-ui.git",
    "directory": "packages/cli"
  },
  "homepage": "https://p-db.github.io/unframed-ui/",
  "bugs": "https://github.com/P-DB/unframed-ui/issues",
  "keywords": [
    "cli",
    "web-components",
    "copy-paste",
    "ui"
  ],
  "type": "module",
  "bin": {
    "unframed": "./dist/index.js"
  },
  "files": [
    "dist",
    "registry.json",
    "skill"
  ],
  "scripts": {
    "registry": "node scripts/build-registry.mjs",
    "build": "npm run registry && npm run skill && rm -rf dist && tsc -p tsconfig.json",
    "test": "npm run build && vitest run",
    "typecheck": "npm run registry && tsc -p tsconfig.json --noEmit",
    "skill": "node scripts/build-skill.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "sucrase": "^3.35.1"
  }
}

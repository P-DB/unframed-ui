  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
      },
      "mono": {
        "$value": "ui-monospace, 'SF Mono', Menlo, Consolas, monospace"
      }
    },
    "size": {
      "$type": "dimension",
      "sm": {
        "$value": "0.8125rem"
      },
      "md": {
        "$value": "0.875rem"
      },
      "lg": {
        "$value": "1rem"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": "4px"
    },
    "md": {
      "$value": "8px"
    },
    "lg": {
      "$value": "12px"
    },
    "full": {
      "$value": "9999px"
    },
    "control": {
      "$value": "0px",
      "$description": "Corners of buttons and form controls. Set e.g. 6px for rounded controls."
    }
  },
  "space": {
    "$type": "dimension",
    "1": {
      "$value": "0.25rem"
    },
    "2": {
      "$value": "0.5rem"
    },
    "3": {
      "$value": "0.75rem"
    },
    "4": {
      "$value": "1rem"
    },
    "5": {
      "$value": "1.25rem"
    },
    "6": {
      "$value": "1.5rem"
    }
  },
  "size": {
    "$type": "dimension",
    "control-sm": {
      "$value": "2rem"
    },
    "control-md": {
      "$value": "2.5rem"
    },
    "control-lg": {
      "$value": "3rem"
    }
  },
  "focus": {
    "ring-width": {
      "$type": "dimension",
      "$value": "2px"
    },
    "ring-offset": {
      "$type": "dimension",
      "$value": "2px"
    }
  },
  "duration": {
    "$type": "duration",
    "fast": {
      "$value": "120ms"
    },
    "base": {
      "$value": "200ms"
    }
  },
  "shadow": {
    "$type": "shadow",
    "sm": {
      "$value": "0 1px 2px rgb(0 0 0 / 0.06)"
    },
    "md": {
      "$value": "0 4px 12px rgb(0 0 0 / 0.10), 0 1px 3px rgb(0 0 0 / 0.08)"
    },
    "lg": {
      "$value": "0 16px 40px rgb(0 0 0 / 0.18), 0 4px 12px rgb(0 0 0 / 0.10)"
    }
  }
}

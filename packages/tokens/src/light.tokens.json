    "$type": "shadow",
    "raised": {
      "$description": "A raised surface, like an elevated card: a soft shadow.",
      "$value": "{shadow.md}"
    },
    "overlay": {
      "$description": "A surface over the page, like a popover, menu or list: a soft shadow.",
      "$value": "{shadow.md}"
    },
    "modal": {
      "$description": "A dialog: a deeper shadow.",
      "$value": "{shadow.lg}"
    },
    "drawer": {
      "$description": "A drawer: as deep as a dialog's, but even on every side, so it shows from whichever edge the drawer comes in.",
